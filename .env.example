# ---- Service ----
PORT=4104
# Interface to listen on. 127.0.0.1 = this machine only. Use 0.0.0.0 to expose it (Docker sets this);
# the server then refuses to start unless API_KEY is set.
HOST=127.0.0.1
# x-api-key value for /api/* (min. 16 characters). Required whenever HOST is not loopback.
# Generate: node -e "console.log(crypto.randomUUID())"
API_KEY=
# true only behind a trusted reverse proxy: rate limiting then uses the X-Forwarded-For client address.
TRUST_PROXY=false
DATABASE_PATH=./data/meetings.db
RATE_LIMIT_PER_MINUTE=20
MAX_BODY_MB=50
MAX_TRANSCRIPT_LINES=5000
# Name used in follow-up email drafts.
FOLLOWUP_SENDER=

# ---- Claude ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FALLBACKS=default

# ---- Optional speech-to-text (Deepgram, https://console.deepgram.com) ----
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ---- n8n ----
TRANSCRIPTS_FOLDER_ID=
