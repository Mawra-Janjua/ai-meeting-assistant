# ---- Service ----
PORT=4104
# Required x-api-key value for /api/*. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=
DATABASE_PATH=./data/meetings.db
RATE_LIMIT_PER_MINUTE=20
MAX_BODY_MB=50
MAX_TRANSCRIPT_LINES=5000
# Name used in follow-up email drafts.
FOLLOWUP_SENDER=

# ---- Claude ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FALLBACKS=default

# ---- Optional speech-to-text (Deepgram, https://console.deepgram.com) ----
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ---- n8n ----
TRANSCRIPTS_FOLDER_ID=
