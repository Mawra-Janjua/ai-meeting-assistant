{
  "name": "ai-meeting-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI meeting assistant: transcript parsing, Claude summaries, evidence-verified decisions and action items, follow-up email drafts, Markdown/JSON export, optional speech-to-text.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "live-check": "node --env-file-if-exists=.env scripts/live-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
